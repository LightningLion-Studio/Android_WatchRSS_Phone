t-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][968,2376]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][968,2376]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,0][968,2376]" drawing-order="0" hint=""><node index="0" text="就在刚刚，GPT-5.6 系列正式发布，不过，它并没有直接全面开放，而是以「有限预览」的方式先行试水。" resource-id="" class="android.widget.TextView" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[45,463][923,615]" drawing-order="0" hint="" /><node index="1" text="作为 OpenAI 最强的一代，GPT-5.6 一口气端出三款型号，名字起得颇有诗意：" resource-id="" class="android.widget.TextView" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[45,651][923,803]" drawing-order="1" hint="" /><node index="2" text="•" resource-id="" class="android.widget.TextView" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,830][76,884]" drawing-order="2" hint="" /><node index="3" text="Sol（太阳）是旗舰模型，也是 OpenAI 口中目前最强的模型；" resource-id="" class="android.widget.TextView" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[94,830][905,938]" drawing-order="3" hint="" /><node index="4" text="•" resource-id="" class="android.widget.TextView" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,956][76,1010]" drawing-order="4" hint="" /><node index="5" text="Terra（地球/大地）是面向日常工作的平衡型模型，性能可以与 GPT-5.5 竞争，同时价格便宜一半；" resource-id="" class="android.widget.TextView" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[94,956][905,1064]" drawing-order="5" hint="" /><node index="6" text="•" resource-id="" class="android.widget.TextView" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1082][76,1136]" drawing-order="6" hint="" /><node index="7" text="Luna（月亮）主打速度和低成本，是 GPT-5.6 系列中最便宜的模型。" resource-id="" class="android.widget.TextView" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[94,1082][905,1190]" drawing-order="7" hint="" /><node index="8" text="从这命名方式来看，奥特曼私底下没少学习 Anthropic 营销的精髓。而借着 GPT-5.6 的发布，OpenAI 也顺手把命名体系重新梳理了一遍：" resource-id="" class="android.widget.TextView" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[45,1217][923,1445]" drawing-order="8" hint="" /><node index="9" text="数字表示代际，Sol、Terra、Luna 对应不同能力层级，便于区分智能水平、速度与成本。产品定位上，Sol 面向高难复杂任务，Terra 覆盖日常工作流，Luna 主打低成本调用。&#10; 换句话说，GPT-5.6 不只是一次能力升级，也是 OpenAI 对模型产品线的一次重新分层。" resource-id="" class="android.widget.TextView" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[45,1481][923,1937]" drawing-order="9" hint="" /><node index="10" text="▲ https://openai.com/index/previewing-gpt-5-6-sol/" resource-id="" class="android.widget.TextView" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[45,1973][923,2125]" drawing-order="10" hint="" /><node index="11" text="GPT-5.6 深夜突袭，能力全系霸榜" resource-id="" class="android.widget.TextView" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[45,2170][817,2250]" drawing-order="11" hint="" /><node index="12" text="作为 OpenAI 迄今最强模型。GPT-5.6 Sol 的能力展示，主要集中在编程、生物信息学和网络安全三个方向。" resource-id="" class="android.widget.TextView" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[45,2295][923,2376]" drawing-order="12" hint="" /></node></node><node index="1" text="刚刚，GPT-5.6 正式发布，史上最强但被自己坑惨了" resource-id="" class="android.widget.TextView" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[36,122][932,274]" drawing-order="1" hint="" /><node index="2" text="爱范儿" resource-id="" class="android.widget.TextView" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[36,301][125,346]" drawing-order="2" hint="" /><node index="3" text="" resource-id="" class="android.view.View" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[36,2254][206,2362]" drawing-order="3" hint=""><node index="0" text="返回" resource-id="" class="android.widget.TextView" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[117,2281][188,2335]" drawing-order="0" hint="" /></node><node index="4" text="" resource-id="" class="android.view.View" package="com.lightningstudio.watchrss.phone" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollabl